# ---------- Core ----------
PORT=4000
# Public URL of the React app (used for redirects after OAuth)
FRONTEND_URL=http://localhost:5173
# Long random string used to sign session + OAuth state JWTs
JWT_SECRET=change-me-to-a-long-random-string

DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# ---------- Google OAuth (https://console.cloud.google.com/apis/credentials) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Goes through the Vite proxy so the session cookie is first-party for the frontend
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ---------- Slack OAuth (https://api.slack.com/apps) ----------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack requires HTTPS redirect URLs: expose the frontend with a tunnel (ngrok / cloudflared)
# and put the tunnel URL here, e.g. https://abc123.ngrok-free.app/api/integrations/slack/callback
SLACK_REDIRECT_URI=http://localhost:5173/api/integrations/slack/callback

# ---------- Ethereal SMTP senders ----------
# Optional explicit accounts: "user1@ethereal.email:pass1,user2@ethereal.email:pass2".
# If empty, the app auto-creates ETHEREAL_SENDER_COUNT accounts via the Ethereal API
# on first start and stores them in Postgres.
ETHEREAL_ACCOUNTS=
ETHEREAL_SENDER_COUNT=3

# ---------- Throughput / rate limiting ----------
# Parallel jobs per worker process
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the SAME sender, enforced across all workers (Redis)
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Hard ceiling per sender per clock hour (Redis counters, shared across workers)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Default per-campaign hourly limit when the compose form leaves it empty
DEFAULT_CAMPAIGN_HOURLY_LIMIT=100
# Retries for transient SMTP failures (exponential backoff)
SEND_MAX_ATTEMPTS=3

# ---------- Bull Board ----------
# If both set, /admin/queues is protected with HTTP basic auth
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
