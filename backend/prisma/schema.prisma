generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  avatarUrl    String?
  googleId     String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())

  campaigns Campaign[]
  emails    Email[]
  slack     SlackIntegration?
}

/// An SMTP identity emails can be sent from (Ethereal test accounts).
model Sender {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  smtpHost  String
  smtpPort  Int
  smtpUser  String
  smtpPass  String
  createdAt DateTime @default(now())

  campaigns Campaign[]
  emails    Email[]
}

/// One "Compose" submission. Fans out into one Email row per recipient.
model Campaign {
  id            String   @id @default(cuid())
  userId        String
  senderId      String
  subject       String
  body          String
  startAt       DateTime
  delayMs       Int
  hourlyLimit   Int
  totalCount    Int
  createdAt     DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender  @relation(fields: [senderId], references: [id])
  emails Email[]
}

enum EmailStatus {
  scheduled
  sending
  sent
  failed
}

model Email {
  id              String      @id @default(cuid())
  campaignId      String
  userId          String
  senderId        String
  seq             Int
  toEmail         String
  subject         String
  status          EmailStatus @default(scheduled)
  scheduledAt     DateTime
  /// Set when a worker claims the email; used to detect crashed sends.
  lockedAt        DateTime?
  sentAt          DateTime?
  attempts        Int         @default(0)
  rescheduleCount Int         @default(0)
  lastError       String?
  messageId       String?
  previewUrl      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id])

  @@unique([campaignId, toEmail])
  @@index([userId, status, scheduledAt])
  @@index([status, scheduledAt])
}

model SlackIntegration {
  id          String   @id @default(cuid())
  userId      String   @unique
  teamId      String
  teamName    String
  channel     String
  webhookUrl  String
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
